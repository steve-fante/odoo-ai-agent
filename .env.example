# Copier ce fichier en .env puis renseigner les valeurs.
# .env est ignoré par git : aucune clé ne doit être committée.

# --- Modèle ---------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Variante OpenAI :
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Base de données ------------------------------------------------------
# Démonstration (par défaut) :
DATABASE_URL=sqlite:///data/demo_odoo.sqlite

# Base Odoo réelle — utiliser un rôle EN LECTURE SEULE :
# DATABASE_URL=postgresql://odoo_lecteur:motdepasse@localhost:5432/odoo_prod

# --- Garde-fous -----------------------------------------------------------
MAX_ROWS=200
QUERY_TIMEOUT_S=10
MAX_AGENT_STEPS=8
